        "custom": {
          "persistent_id": "ce617379-f4c2-4082-9053-ad89c8287f36",
          "_collapsed": false,
          "_exec_mode": "subprocess",
          "version": "latest",
          "left": 200,
          "right": 200,
          "top": 200,
          "bottom": 200,
          "feathering": 50,
          "debug_code": "# -*- coding: utf-8 -*-\nimport importlib.util\nfrom pathlib import Path\nbase_path = Path(__file__).parent.parent / \"base.py\"\nspec = importlib.util.spec_from_file_location(\"base\", str(base_path))\nbase_module = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(base_module)\n\n# 导入所需项目\nBaseComponent = base_module.BaseComponent\nPortDefinition = base_module.PortDefinition\nPropertyDefinition = base_module.PropertyDefinition\nPropertyType = base_module.PropertyType\nArgumentType = base_module.ArgumentType\nConnectionType = base_module.ConnectionType\n\n\nclass ImagePadForOutpainting(BaseComponent):\n    name = \"图像扩图填充\"\n    category = \"图像处理\"\n    description = \"为图像添加边距，生成用于扩图的画布和遮罩\"\n    requirements = \"Pillow\"\n    \n    inputs = [\n        PortDefinition(name=\"image\", label=\"输入图像\", type=ArgumentType.IMAGE),\n    ]\n    outputs = [\n        PortDefinition(name=\"padded_image\", label=\"扩图画布\", type=ArgumentType.IMAGE),\n        PortDefinition(name=\"mask\", label=\"遮罩图\", type=ArgumentType.IMAGE),\n    ]\n    \n    properties = {\n        \"left\": PropertyDefinition(\n            type=PropertyType.INT,\n            default=0,\n            label=\"左扩展\",\n        ),\n        \"right\": PropertyDefinition(\n            type=PropertyType.INT,\n            default=0,\n            label=\"右扩展\",\n        ),\n        \"top\": PropertyDefinition(\n            type=PropertyType.INT,\n            default=0,\n            label=\"上扩展\",\n        ),\n        \"bottom\": PropertyDefinition(\n            type=PropertyType.INT,\n            default=0,\n            label=\"下扩展\",\n        ),\n        \"feathering\": PropertyDefinition(\n            type=PropertyType.INT,\n            default=20,\n            label=\"边缘羽化\",\n        ),\n    }\n\n    def run(self, params, inputs=None):\n        from PIL import Image, ImageOps, ImageFilter\n        import numpy as np\n\n        # 1. 获取输入图像并转为 RGB（防止 RGBA 导致的透明度干扰）\n        src_img = inputs.get(\"image\")\n        if src_img is None:\n            raise ValueError(\"未检测到输入图像\")\n        \n        src_img = src_img.convert(\"RGB\") \n        \n        left = int(params.get(\"left\", 0))\n        right = int(params.get(\"right\", 0))\n        top = int(params.get(\"top\", 0))\n        bottom = int(params.get(\"bottom\", 0))\n        \n        new_width = src_img.width + left + right\n        new_height = src_img.height + top + bottom\n\n        # 2. 创建扩图后的画布 (Padded Image)\n        # 建议默认用黑色，因为采样器对黑色背景的重绘更稳定\n        fill_color = (0, 0, 0) if params.get(\"fill_color\") == \"black\" else (255, 255, 255)\n        padded_img = Image.new(\"RGB\", (new_width, new_height), fill_color)\n        \n        # 将原图粘贴到中心指定位置\n        # padded_img.paste(src_img, (left, top))\n\n        # 3. 创建遮罩 (Mask) \n        # 逻辑：原图区域为黑色(0, 0, 0)，需要扩绘的区域为白色(255, 255, 255)\n        # 注意：这里先创建一个全白的图\n        mask = Image.new(\"L\", (new_width, new_height), 255)\n        \n        # 在原图对应的位置，画一个纯黑的矩形\n        # 这样采样器就知道：黑色的地方不要动，白色的地方重新画\n        black_rect = Image.new(\"L\", (src_img.width, src_img.height), 0)\n        mask.paste(black_rect, (left, top))\n\n        # 4. 可选：对遮罩边缘做微量羽化，防止扩图处有硬连接痕迹\n        mask = mask.filter(ImageFilter.GaussianBlur(radius=5))\n\n        # 【核心修正】：为了让 UI 预览正常，将 L 模式的遮罩转回 RGB 输出\n        # 否则某些低代码前端会将灰度图识别错误\n        mask_rgb = mask.convert(\"RGB\")\n        print(src_img.size)\n        return {\n            \"padded_image\": src_img, # 这是一个中间有原图，四周是黑边的图\n            \"mask\": mask_rgb            # 这是一个中间是黑块，四周是白边的图\n        }"
        }
      },
