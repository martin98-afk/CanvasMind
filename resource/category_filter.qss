/* category_filter.qss */
CategoryFilterDialog QFrame {
    background-color: #2D2D2D;
    border: 1px solid #4A4A4A;
    border-radius: 6px;
    padding: 5px;
}

CategoryFilterDialog QPushButton {
    background-color: #4A4A4A;
    color: white;
    border: 1px solid #666666;
    border-radius: 4px;
    padding: 4px 8px;
}

CategoryFilterDialog QPushButton:hover {
    background-color: #5A5A5A;
}

CategoryFilterDialog QPushButton:pressed {
    background-color: #3A3A3A;
}

CategoryFilterDialog QCheckBox {
    color: white;
    spacing: 5px;
}

CategoryFilterDialog QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #666666;
    border-radius: 3px;
    background-color: #3D3D3D;
}

CategoryFilterDialog QCheckBox::indicator:checked {
    background-color: #007ACC;
    border: 1px solid #007ACC;
}

CategoryFilterDialog QCheckBox::indicator:hover {
    border: 1px solid #888888;
}

CategoryFilterDialog QCheckBox::indicator:checked:hover {
    background-color: #0088E6;
}