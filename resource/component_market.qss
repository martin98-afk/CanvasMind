#MarketCenter { background-color: #0b0e14; }
#SideBar { background-color: #11141a; border-right: 1px solid #1f6feb; }
#NavBtn {
    border: none; color: #8b949e; padding: 15px 25px; text-align: left;
    font-size: 15px; font-weight: bold; border-radius: 0px;
}
#NavBtn:hover { background-color: #1c2128; color: #58a6ff; }
#NavBtn:checked { background-color: #1f6feb22; color: #58a6ff; border-left: 4px solid #58a6ff; }

#CategoryTitle {
    color: #58a6ff; font-size: 16px; font-weight: 900;
    padding: 10px 5px; margin-top: 15px; border-bottom: 1px solid #30363d;
}

/* 卡片样式：强化边界线 */
#ComponentCard {
    background-color: #161b22;
    border: 1px solid #30363d; /* 默认灰色边界 */
    border-radius: 10px;
}
#ComponentCard:hover {
    border: 1px solid #58a6ff; /* 悬浮蓝边 */
    background-color: #1c2128;
}

#CardTitle { color: #f0f6fc; font-size: 16px; font-weight: bold; }
#CardUUID { color: #58a6ff; font-family: 'Consolas'; font-size: 11px; opacity: 0.8; }
#CardDesc { color: #8b949e; font-size: 13px; line-height: 18px; }

#BtnAction {
    border-radius: 4px; padding: 8px 15px; font-weight: bold; font-size: 12px;
    border: 1px solid #30363d; background: #21262d; color: #c9d1d9;
}
#BtnAction:hover { background: #30363d; border-color: #8b949e; }
#BtnDownload { background: #238636; color: white; border: none; }
#BtnDownload:hover { background: #2ea043; }
#BtnAction:disabled { color: #484f58; background: #0d1117; }