输出端口名）\n        """\n        # 导入第三方库\n        import pdfplumber\n        import python_docx\n        \n        # 获取上传的文档\n        document = inputs.get("document") if inputs else None\n        \n        # 初始化结果\n        result = {\n            "content": "",\n            "metadata": {}\n        }\n        \n        # 处理PDF文档\n        if document and document.endswith(".pdf"):\n            with pdfplumber.open(document) as pdf:\n                # 提取文本内容\n                content = ""\n                for page in pdf.pages:\n                    content += page.extract_text()\n                \n                # 提取元数据\n                metadata = {\n                    "number_of_pages": len(pdf.pages),\n                    "total_words": len(content.split())\n                }\n                \n                # 处理配置参数\n                config = params.extract_config\n                result["content"] = self._process_content(content, config)\n                result["metadata"] = metadata\n                \n        # 处理Word文档\n        elif document and document.endswith(".docx"):\n            doc = python_docx.Document(document)\n            content = ""\n            tables = []\n            headings = []\n            \n            # 提取内容\n            for para in doc.paragraphs:\n                content += para.text + "\\n"\n            \n            # 提取表格\n            for table in doc.tables:\n                table_data = []\n                for row in table.rows:\n                    row_data = [cell.text for cell in row.cells]\n                    table_data.append(row_data)\n                tables.append(table_data)\n            \n            # 提取标题\n            for i, para in enumerate(doc.paragraphs):\n                if para.style.name.startswith(\'Heading\'):\n                    headings.append({\n                        "level": int(para.style.name[-1]),\n                        "text": para.text\n                    })\n            \n            # 处理配置参数\n            config = params.extract_config\n            result["content"] = self._process_content(content, config)\n            result["metadata"] = {\n                "number_of_paragraphs": len(doc.paragraphs),\n                "number_of_tables": len(tables),\n                "number_of_headings": len(headings)\n            }\n        \n        # 返回解析结果\n        return {\n            "output1": result\n        }\n    \n    def _process_content(self, content, config):\n        """处理内容并根据配置提取片段"""\n        # 实现具体的文本处理逻辑\n        # 这里只是一个示例实现\n        lines = content.split("\\n")\n        processed_lines = []\n        \n        for line in lines:\n            # 检查是否包含配置中的章节标题\n            if any(title in line for title in config.section_headers):\n                processed_lines.append(line)\n            \n            # 限制最大长度\n            if len(processed_lines) * 100 > config.max_length:\n                break\n        \n        return "\\n".join(processed_lines)', refusal=None, role='assistant', annotations=None, audio=None, function_call=None, tool_calls=[], reasoning_content=None), stop_reason=None, token_ids=None)], created=1763085436, model='qwen3-30b-a3b', object='chat.completion', service_tier=None, system_fingerprint=None, usage=CompletionUsage(completion_tokens=978, prompt_tokens=1234, total_tokens=2212, completion_tokens_details=None, prompt_tokens_details=None), prompt_logprobs=None, prompt_token_ids=None, kv_transfer_params=None)
